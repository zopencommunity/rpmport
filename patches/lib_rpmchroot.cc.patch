diff --git a/lib/rpmchroot.cc b/lib/rpmchroot.cc
index 040b6ac..b13f821 100644
--- a/lib/rpmchroot.cc
+++ b/lib/rpmchroot.cc
@@ -71,7 +71,15 @@ int rpmChrootIn(void)
 	rootState.chrootDone++;
     } else if (rootState.chrootDone == 0) {
 	rpmlog(RPMLOG_DEBUG, "entering chroot %s\n", rootState.rootDir);
-	if (chdir("/") == 0 && chroot(rootState.rootDir) == 0) {
+	if (getuid() != 0) {
+	    rpmlog(RPMLOG_DEBUG, "bypassing physical chroot for non-root user\n");
+	    if (chdir(rootState.rootDir) == 0) {
+		rootState.chrootDone = 1;
+	    } else {
+		rpmlog(RPMLOG_ERR, _("Unable to change working directory to %s: %m\n"), rootState.rootDir);
+		rc = -1;
+	    }
+	} else if (chdir("/") == 0 && chroot(rootState.rootDir) == 0) {
 	    rootState.chrootDone = 1;
 	} else {
 	    rpmlog(RPMLOG_ERR, _("Unable to change root directory: %m\n"));
@@ -97,7 +105,14 @@ int rpmChrootOut(void)
 	rootState.chrootDone--;
     } else if (rootState.chrootDone == 1) {
 	rpmlog(RPMLOG_DEBUG, "exiting chroot %s\n", rootState.rootDir);
-	if (chroot(".") == 0 && fchdir(rootState.cwd) == 0) {
+	if (getuid() != 0) {
+	    if (fchdir(rootState.cwd) == 0) {
+		rootState.chrootDone = 0;
+	    } else {
+		rpmlog(RPMLOG_ERR, _("Unable to restore working directory: %m\n"));
+		rc = -1;
+	    }
+	} else if (chroot(".") == 0 && fchdir(rootState.cwd) == 0) {
 	    rootState.chrootDone = 0;
 	} else {
 	    rpmlog(RPMLOG_ERR, _("Unable to restore root directory: %m\n"));
@@ -111,3 +126,9 @@ int rpmChrootDone(void)
 {
     return (rootState.chrootDone > 0);
 }
+
+const char *rpmChrootPath(void)
+{
+    const char *path = rootState.rootDir;
+    return (path && rstreq(path, "/")) ? NULL : path;
+}
