+/*
+ * Extract an archive to disk (with -x).
+ *
+ * archive_read_support_format_all() + archive_read_support_filter_all()
+ * covers tar+any-compression, zip, and 7zip natively.
+ *
+ * When -C dstpath is given and the archive has a single root directory,
+ * that root component is stripped (equivalent to tar --strip-components=1)
+ * by rewriting the entry pathname (and hardlink target) before handing it
+ * to archive_write_disk.
+ */
+static int doUntar_libarchive(const char *fn, const struct archiveType_s *at)
+{
+    char *sr = dstpath ? singleRoot(fn) : NULL;
+    char *dest = NULL;		/* canonicalized -C destination */
+    struct archive *a;
+    struct archive *ext;
+    struct archive_entry *entry;
+    int r;
+    int rc = EXIT_SUCCESS;
+
+    if (rpmIsVerbose() || dryrun)
+	fprintf(stderr, "rpmuncompress: extracting %s%s%s\n", fn,
+		dstpath ? " -> " : "", dstpath ? dstpath : "");
+
+    if (dryrun) {
+	free(sr);
+	return EXIT_SUCCESS;
+    }
+
+    /* zip timestamps are stored as UTC, like the old TZ=UTC unzip */
+    if (at->setTZ) {
+	setenv("TZ", "UTC", 1);
+	tzset();
+    }
+
+    a = archive_read_new();
+    archive_read_support_format_all(a);
+    archive_read_support_filter_all(a);
+    ext = archive_write_disk_new();
+    archive_write_disk_set_options(ext,
+	ARCHIVE_EXTRACT_TIME |
+	ARCHIVE_EXTRACT_ACL | ARCHIVE_EXTRACT_FFLAGS | ARCHIVE_EXTRACT_XATTR |
+	ARCHIVE_EXTRACT_SECURE_SYMLINKS | ARCHIVE_EXTRACT_SECURE_NODOTDOT |
+	ARCHIVE_EXTRACT_SAFE_WRITES);
+    archive_write_disk_set_standard_lookup(ext);
+
+    /* never overwrite our own input (an uncompressed tar containing
+     * a member of its own name; link entries are covered too) */
+    {
+	struct stat st;
+	if (stat(fn, &st) == 0)
+	    archive_write_disk_set_skip_file(ext, st.st_dev, st.st_ino);
+    }
+
+    if (archive_read_open_filename(a, fn, 10240) != ARCHIVE_OK) {
+	fprintf(stderr, "rpmuncompress: %s: %s\n", fn, archive_error_string(a));
+	rc = EXIT_FAILURE;
+	goto out;
+    }
+
+    if (dstpath) {
+	if (rpmioMkpath(dstpath, 0755, getuid(), getgid()) != 0) {
+	    fprintf(stderr, "rpmuncompress: mkdir %s: %s\n", dstpath, strerror(errno));
+	    rc = EXIT_FAILURE;
+	    goto out;
+	}
+	dest = realpath(dstpath, NULL);
+	if (dest == NULL) {
+	    fprintf(stderr, "rpmuncompress: realpath %s: %s\n", dstpath, strerror(errno));
+	    rc = EXIT_FAILURE;
+	    goto out;
+	}
+    }
+
+    for (;;) {
+	r = archive_read_next_header(a, &entry);
+	if (r == ARCHIVE_EOF)
+	    break;
+	if (r < ARCHIVE_WARN) {
+	    fprintf(stderr, "rpmuncompress: %s\n", archive_error_string(a));
+	    rc = EXIT_FAILURE;
+	    break;
+	}
+
+	if (dstpath) {
+	    /* strip the single root directory (tar --strip-components=1)
+	     * and prefix the destination */
+	    const char *orig = archive_entry_pathname(entry);
+	    while (*orig == '/')
+		orig++;
+	    const char *rel = orig;
+	    if (sr) {
+		size_t srlen = strlen(sr);
+		if (strncmp(orig, sr, srlen) == 0 &&
+		    (orig[srlen] == '/' || orig[srlen] == '\0'))
+		    rel = (orig[srlen] == '/') ? orig + srlen + 1 : orig + srlen;
+	    }
+	    if (*rel == '\0')
+		continue;	/* the root dir entry itself */
+	    char *newpath = NULL;
+	    rasprintf(&newpath, "%s/%s", dest, rel);
+	    archive_entry_set_pathname(entry, newpath);
+	    free(newpath);
+	    /* relocate hardlink targets into the destination too,
+	     * stripping the same root component */
+	    const char *hl = archive_entry_hardlink(entry);
+	    if (hl) {
+		while (*hl == '/')
+		    hl++;
+		const char *hrel = hl;
+		if (sr) {
+		    size_t srlen = strlen(sr);
+		    if (strncmp(hl, sr, srlen) == 0 &&
+			(hl[srlen] == '/' || hl[srlen] == '\0'))
+			hrel = (hl[srlen] == '/') ? hl + srlen + 1 : hl + srlen;
+		}
+		if (*hrel == '\0')
+		    continue;	/* target reduced to nothing: skip */
+		char *newhl = NULL;
+		rasprintf(&newhl, "%s/%s", dest, hrel);
+		archive_entry_set_hardlink(entry, newhl);
+		free(newhl);
+	    }
+	} else {
+	    /* like tar: strip leading slashes from absolute member and
+	     * hardlink paths, never honor them */
+	    const char *orig = archive_entry_pathname(entry);
+	    while (*orig == '/')
+		orig++;
+	    if (*orig == '\0')
+		continue;
+	    if (orig != archive_entry_pathname(entry))
+		archive_entry_set_pathname(entry, orig);
+	    const char *hl = archive_entry_hardlink(entry);
+	    if (hl) {
+		while (*hl == '/')
+		    hl++;
+		if (*hl != '\0')
+		    archive_entry_set_hardlink(entry, hl);
+	    }
+	}
+
+	/* zip: like unzip -u, keep existing files that are the same age
+	 * or newer than the archived copy */
+	if (at->compressed == COMPRESSED_ZIP) {
+	    struct stat zst;
+	    if (stat(archive_entry_pathname(entry), &zst) == 0 &&
+		!S_ISDIR(zst.st_mode) &&
+		zst.st_mtime >= archive_entry_mtime(entry))
+		continue;
+	}
+
+	if (rpmIsVerbose())
+	    fprintf(stderr, "  %s\n", archive_entry_pathname(entry));
+
+	r = archive_write_header(ext, entry);
+	if (r < ARCHIVE_OK)
+	    fprintf(stderr, "rpmuncompress: %s\n", archive_error_string(ext));
+	if (r < ARCHIVE_WARN) {
+	    rc = EXIT_FAILURE;
+	    break;
+	}
+
+	r = copy_data(a, ext);
+	if (r < ARCHIVE_OK) {
+	    fprintf(stderr, "rpmuncompress: %s\n", archive_error_string(a));
+	    rc = EXIT_FAILURE;
+	    break;
+	}
+
+	r = archive_write_finish_entry(ext);
+	if (r < ARCHIVE_OK)
+	    fprintf(stderr, "rpmuncompress: %s\n", archive_error_string(ext));
+	if (r < ARCHIVE_WARN) {
+	    rc = EXIT_FAILURE;
+	    break;
+	}
+    }
+
+out:
+    archive_read_close(a);
+    archive_read_free(a);
+    archive_write_close(ext);
+    archive_write_free(ext);
+    free(sr);
+    free(dest);
+    return rc;
+}
