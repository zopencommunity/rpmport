+#include <rpm/rpmfileutil.h>
+#include <rpm/rpmio.h>
+#include <sys/stat.h>
+/*
+ * Decompress only (no -x): stream the raw decompressed bytes to stdout.
+ *
+ * archive_read_support_format_raw() treats the file as an opaque compressed
+ * stream and simply decompresses it, without parsing any archive format.
+ *
+ * Exactly ONE filter (matching the detected format) is registered: the
+ * previous tools (gzip -dc, xz -dc ...) also removed only a single
+ * compression layer, whereas automatic filter stacking would happily
+ * decompress foo.gz.gz twice.
+ *
+ * Returns -1 when the input needs the shell fallback (e.g. more than one
+ * compression layer detected, which the shell tools handle one layer at
+ * a time).
+ */
+static int doUncompress_libarchive(const char *fn, const struct archiveType_s *at)
+{
+    if (rpmIsVerbose() || dryrun)
+	fprintf(stderr, "rpmuncompress: decompressing %s\n", fn);
+
+    if (dryrun)
+	return EXIT_SUCCESS;
+
+    struct archive *a = archive_read_new();
+    /* register only the filter matching the detected type so exactly
+     * one compression layer is removed */
+    switch (at->compressed) {
+    case COMPRESSED_BZIP2:
+	archive_read_support_filter_bzip2(a);
+	break;
+    case COMPRESSED_XZ:
+	archive_read_support_filter_xz(a);
+	break;
+    case COMPRESSED_LZMA:
+	archive_read_support_filter_lzma(a);
+	break;
+    case COMPRESSED_ZSTD:
+	archive_read_support_filter_zstd(a);
+	break;
+    case COMPRESSED_LZIP:
+	archive_read_support_filter_lzip(a);
+	break;
+    default:
+	/* COMPRESSED_OTHER: gzip (1f8b) or compress (1f9d) */
+	archive_read_support_filter_gzip(a);
+	archive_read_support_filter_compress(a);
+	break;
+    }
+    archive_read_support_format_raw(a);
+    /* recognize empty (zero-length) streams as valid */
+    archive_read_support_format_empty(a);
+
+    if (archive_read_open_filename(a, fn, 64 * 1024) != ARCHIVE_OK) {
+	/* let the shell tool decide: it fails on genuinely corrupt
+	 * input, and peels one layer of stacked same-type streams */
+	archive_read_free(a);
+	return -1;
+    }
+
+    struct archive_entry *entry;
+    int r = archive_read_next_header(a, &entry);
+    /* exactly one decompression filter must have engaged: more
+     * means stacked layers (e.g. foo.gz.gz), which the shell tools
+     * peel one at a time like before; none means the recognized
+     * signature did not decode, which the shell tools reject */
+    int fc = archive_filter_count(a);
+    if (fc > 2) {
+	archive_read_free(a);
+	return -1;
+    }
+    if (fc < 2) {
+	fprintf(stderr, "rpmuncompress: %s: unrecognized compressed data\n", fn);
+	archive_read_free(a);
+	return EXIT_FAILURE;
+    }
+    if (r == ARCHIVE_EOF) {
+	/* valid but empty decompressed stream: nothing to output */
+	archive_read_free(a);
+	return EXIT_SUCCESS;
+    }
+    if (r != ARCHIVE_OK) {
+	fprintf(stderr, "rpmuncompress: %s: %s\n", fn, archive_error_string(a));
+	archive_read_free(a);
+	return EXIT_FAILURE;
+    }
+
+    char buf[64 * 1024];
+    ssize_t nb;
+    int rc = EXIT_SUCCESS;
+
+    while ((nb = archive_read_data(a, buf, sizeof(buf))) > 0) {
+	if (fwrite(buf, 1, nb, stdout) != (size_t)nb) {
+	    fprintf(stderr, "rpmuncompress: write error: %s\n", strerror(errno));
+	    rc = EXIT_FAILURE;
+	    break;
+	}
+    }
+    if (nb < 0) {
+	fprintf(stderr, "rpmuncompress: %s: %s\n", fn, archive_error_string(a));
+	rc = EXIT_FAILURE;
+    }
+
+    archive_read_free(a);
+    return rc;
+}
+
+/*
+ * copy_data() and doUntar_libarchive() follow the canonical libarchive
+ * "A Complete Extractor" example:
+ * https://github.com/libarchive/libarchive/wiki/Examples#a-complete-extractor
+ */
+static int copy_data(struct archive *ar, struct archive *aw)
+{
+    const void *buff;
+    size_t size;
+    int64_t offset;
+    int r;
+
+    for (;;) {
+	r = archive_read_data_block(ar, &buff, &size, &offset);
+	if (r == ARCHIVE_EOF)
+	    return ARCHIVE_OK;
+	if (r != ARCHIVE_OK)
+	    return r;
+	r = archive_write_data_block(aw, buff, size, offset);
+	if (r != ARCHIVE_OK) {
+	    fprintf(stderr, "rpmuncompress: %s\n", archive_error_string(aw));
+	    return r;
+	}
+    }
+}
