diff --git a/rpmio/rpmglob.cc b/rpmio/rpmglob.cc
index 90426b7..d302cd9 100644
--- a/rpmio/rpmglob.cc
+++ b/rpmio/rpmglob.cc
@@ -62,6 +62,10 @@ int rpmGlobPath(const char * pattern, rpmglobFlags flags,
     glob_t gl;
     int gflags = 0;
     int rc = 0;
+#ifndef GLOB_TILDE
+    const char *glob_pattern = pattern;
+    char *expanded_pattern = NULL;
+#endif
 
 #ifdef ENABLE_NLS
     char * old_collate = NULL;
@@ -77,10 +81,13 @@ int rpmGlobPath(const char * pattern, rpmglobFlags flags,
 	argvAdd(argvPtr, pattern);
 	goto exit;
     }
-
+#ifdef GLOB_BRACE
     gflags |= GLOB_BRACE;
-    if (home != NULL && strlen(home) > 0) 
+#endif
+    if (home != NULL && strlen(home) > 0)
+#ifdef GLOB_TILDE 
 	gflags |= GLOB_TILDE;
+#endif
 #if HAVE_GLOB_ONLYDIR
     if (dir_only)
 	gflags |= GLOB_ONLYDIR;
@@ -102,7 +109,23 @@ int rpmGlobPath(const char * pattern, rpmglobFlags flags,
     gl.gl_pathc = 0;
     gl.gl_pathv = NULL;
     
+    /* Manually expand tilde when GLOB_TILDE is not available (z/OS) */
+#ifndef GLOB_TILDE
+    if (pattern[0] == '~' && (pattern[1] == '/' || pattern[1] == '\0')) {
+        if (home != NULL && strlen(home) > 0) {
+            if (pattern[1] == '/') {
+                expanded_pattern = (char *)malloc(strlen(home) + strlen(pattern));
+                sprintf(expanded_pattern, "%s%s", home, pattern + 1);
+            } else {
+                expanded_pattern = strdup(home);
+            }
+            glob_pattern = expanded_pattern;
+        }
+    }
+    rc = glob(glob_pattern, gflags, NULL, &gl);
+#else
     rc = glob(pattern, gflags, NULL, &gl);
+#endif
     if (rc)
 	goto exit;
 
@@ -115,6 +138,10 @@ int rpmGlobPath(const char * pattern, rpmglobFlags flags,
 	argvAdd(argvPtr, gl.gl_pathv[i]);
     }
     globfree(&gl);
+#ifndef GLOB_TILDE
+    if (expanded_pattern)
+        free(expanded_pattern);
+#endif
 
 exit:
     argc = argvCount(*argvPtr);
