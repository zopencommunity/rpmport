diff --git a/lib/fsm-zos-helper.cc b/lib/fsm-zos-helper.cc
new file mode 100644
--- /dev/null
+++ b/lib/fsm-zos-helper.cc
@@ -0,0 +1,39 @@
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "fsm-zos.hh"
+
+int main(int argc, char **argv)
+{
+    fsmZosResult result = { -1, EINVAL };
+
+    if (argc == 4 &&
+	(strcmp(argv[1], "link") == 0 || strcmp(argv[1], "rename") == 0)) {
+	/* z/OS can leak a directory fd used for both sides of *at().
+	 * Only this exec'd, single-threaded helper may change cwd. */
+	result.rc = fchdir(4);
+	if (result.rc == 0) {
+	    if (strcmp(argv[1], "link") == 0)
+		result.rc = linkat(3, argv[2], AT_FDCWD, argv[3], 0);
+	    else
+		result.rc = renameat(3, argv[2], AT_FDCWD, argv[3]);
+	}
+	result.error = result.rc < 0 ? errno : 0;
+    }
+
+    const char *p = reinterpret_cast<const char *>(&result);
+    size_t left = sizeof(result);
+    while (left) {
+	ssize_t n = write(5, p, left);
+	if (n < 0 && errno == EINTR)
+	    continue;
+	if (n <= 0)
+	    return 1;
+	p += n;
+	left -= n;
+    }
+    return 0;
+}
