+    mem = (uint64_t)((int)((char *__ptr32 *__ptr32 *)0)[4][214]) * 1024;
+#else
     long int pagesize = sysconf(_SC_PAGESIZE);
     long int pages = sysconf(_SC_PHYS_PAGES);
 
