diff --git a/macros.in b/macros.in
index d0cfde4..54280bb 100644
--- a/macros.in
+++ b/macros.in
@@ -228,6 +228,8 @@ Supplements:   (%{name} = %{version}-%{release} and langpacks-%{1})\
 # Their purpose is to set up global filtering for all packages. If you need
 # to set up specific filtering for your package use %__requires_exclude_from
 # and %__provides_exclude_from instead.
+# z/OS: Exclude common interpreter paths from auto-generated Requires:
+%__requires_exclude	^(/bin/bash|/usr/bin/perl)$
 %__global_requires_exclude_from		%{?_docdir:%{_docdir}}
 %__global_provides_exclude_from		%{?_docdir:%{_docdir}}
 
@@ -375,7 +377,8 @@ Supplements:   (%{name} = %{version}-%{release} and langpacks-%{1})\
 #	See rpm-payloadflags(7).
 #
 #%_source_payload	w9.gzdio
-%_binary_payload	%[ %_rpmformat >=6 ? "w19.zstdio" : "w9.gzdio" ]
+# z/OS: Use lower compression level for faster builds
+%_binary_payload	%[ %_rpmformat >=6 ? "w3.zstdio" : "w9.gzdio" ]
 
 #	Algorithm to use for generating file checksum digests on build.
 #	If not specified or 0, MD5 is used.
@@ -643,7 +646,8 @@ Supplements:   (%{name} = %{version}-%{release} and langpacks-%{1})\
 #	The output binary package file name template used when building
 #	binary packages, as described by rpm-queryformat(7).
 #
-%_build_name_fmt<l>	%{ARCH}/%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}.rpm
+# z/OS: Use target platform instead of ARCH for package naming
+%_build_name_fmt<l>	%{_target_platform}/%{NAME}-%{VERSION}-%{RELEASE}.%{_target_platform}.rpm
 
 #	Verify digest/signature flags for various rpm modes:
 #	0x30300 (RPMVSF_MASK_NODIGESTS)    --nohdrchk      if set, don't check digest(s)
